{
  "name": "wyarden-monitor-3d",
  "displayName": "Wyarden 3D Monitor",
  "description": "Watch live Claude Code, Codex, Grok Build and Antigravity activity across your open editor windows.",
  "version": "0.2.0",
  "publisher": "r-spring",
  "icon": "media/wyarden-icon.png",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/r-spring/wyarden.git",
    "directory": "ui-concepts/monitor-3d-live"
  },
  "homepage": "https://github.com/r-spring/wyarden#readme",
  "bugs": {
    "url": "https://github.com/r-spring/wyarden/issues"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "coding agents",
    "claude code",
    "monitor",
    "3d",
    "mcp"
  ],
  "engines": {
    "vscode": "^1.88.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:wyardenMonitor.view",
    "onWebviewPanel:wyardenMonitor.window"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Only folders on a disk are shown as workspaces."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "wyardenMonitor.open",
        "title": "Wyarden 3D Monitor: Open"
      },
      {
        "command": "wyardenMonitor.chooseWorkspace",
        "title": "Wyarden 3D Monitor: Choose Workspace"
      },
      {
        "command": "wyardenMonitor.setupCollectors",
        "title": "Wyarden 3D Monitor: Set Up Collectors…"
      },
      {
        "command": "wyardenMonitor.removeCollectors",
        "title": "Wyarden 3D Monitor: Remove Collectors"
      },
      {
        "command": "wyardenMonitor.status",
        "title": "Wyarden 3D Monitor: Status"
      }
    ]
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "package": "node tools/pack.js"
  }
}
